# Frontend Environment Variables
# Copy this to .env.local for local development
# or set in Render dashboard for production

# LOCAL DEVELOPMENT
# Point to API Gateway running on localhost
VITE_API_URL=http://localhost:8000

# PRODUCTION (Render or GitHub Pages)
# Point to your API Gateway URL from Render
# VITE_API_URL=https://brainforge-tjls.onrender.com

